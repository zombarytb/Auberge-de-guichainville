# Port sur lequel le site va tourner en local (ex: http://localhost:3000)
PORT=3000

# Configuration de la boîte mail qui ENVOIE les notifications
# (Pour le test, tu peux utiliser une adresse Gmail, Outlook, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# L'adresse mail du propriétaire qui REÇOIT les réservations
EMAIL_RECEIVER=
